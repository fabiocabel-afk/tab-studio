{
  "name": "Tab Studio — Tablaturas e Partituras",
  "short_name": "Tab Studio",
  "description": "Leitor, player e editor de tablaturas Guitar Pro (GP3 a GP8) e MusicXML, com impressão e braço 3D.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16141c",
  "theme_color": "#16141c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/x-guitar-pro": [".gp", ".gp3", ".gp4", ".gp5", ".gpx"],
        "application/vnd.recordare.musicxml+xml": [".musicxml", ".xml"],
        "application/vnd.recordare.musicxml": [".mxl"]
      }
    }
  ]
}
